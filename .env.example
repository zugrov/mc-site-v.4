# Скопировать в server/.env на VPS (не коммитить реальные значения)

PORT=3001

# Bitrix24 входящий вебхук, например:
# https://yourportal.bitrix24.ru/rest/1/xxxxxxxxxxxx/crm.lead.add.json
BITRIX24_WEBHOOK_URL=

# Telegram Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Таймаут внешних вызовов (мс)
EXTERNAL_TIMEOUT_MS=5000

# Яндекс.Метрика — экспорт офлайн-конверсий (cron scripts/export-offline-conversions.js)
YANDEX_METRIKA_COUNTER_ID=112291401
YANDEX_METRIKA_OAUTH_TOKEN=

# Маппинг STATUS_ID сделки Bitrix24 → идентификатор цели в Метрике (JSON)
# Пример: {"C2:UC_MEETING":"meeting_held","C2:WON":"won"}
BITRIX_CONVERSION_GOALS=

# Коды пользовательских полей Bitrix24 (опционально; если пусто — парсинг COMMENTS лида)
BITRIX_UF_CLIENT_ID_CODE=
BITRIX_UF_YCLID_CODE=
BITRIX_UF_LEAD_ID_CODE=

# Структурные поля лида при создании (JSON: ключ payload → код UF_CRM_*)
# Пример: {"utm_source":"UF_CRM_UTM_SOURCE","client_id":"UF_CRM_CLIENT_ID","lead_id":"UF_CRM_LEAD_ID"}
BITRIX_LEAD_FIELD_CODES=

# Ответственный по умолчанию (ID пользователя Bitrix24)
BITRIX_DEFAULT_OWNER_ID=

# Рабочие часы для SLA (JSON). По умолчанию: будни 9:00–19:00 Europe/Moscow, SLA 15 мин
# BITRIX_WORK_HOURS={"timezone":"Europe/Moscow","days":[1,2,3,4,5],"startHour":9,"endHour":19,"slaMinutes":15}

# Telegram: личный чат менеджера (уведомление о новой задаче) и чат эскалации
TELEGRAM_MANAGER_CHAT_ID=
TELEGRAM_ESCALATION_CHAT_ID=

# Секрет для входящего вебхука Bitrix24 (экспорт конверсий по событию)
BITRIX_WEBHOOK_SECRET=

# Валюта для won_* офлайн-конверсий
YANDEX_METRIKA_CURRENCY=RUB
